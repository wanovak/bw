# ---- Required ------------------------------------------------------------
# Free key: https://aistudio.google.com/apikey  ->  "Create API key" (no credit card)
GEMINI_API_KEY=

# Random secrets. Generate your own with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
PARENT_ID_HMAC_SECRET=change-me
PII_ENCRYPTION_KEY=change-me

# ---- Operator account ------------------------------------------------------
DEFAULT_OPERATOR_EMAIL=admin@littleacorns.test
# Leave blank to generate a random password, printed once in `docker compose logs backend`
# (also saved in the data volume at /data/initial_operator_credentials.txt).
DEFAULT_OPERATOR_PASSWORD=

# ---- Optional --------------------------------------------------------------
# gemini = real model (default). mock = offline extractive stand-in, no key needed (demo/dev only).
LLM_MODE=gemini
GEMINI_MODEL=gemini-3.5-flash
CONFIDENCE_THRESHOLD=0.90
RATE_LIMIT_PER_HOUR=20
# Seed ~30 days of fake history, a demo parent (demo.parent@example.com) and a demo spike.
SEED_DEMO_DATA=true
DEMO_PARENT_PASSWORD=DemoParent123!
# Host port for the web app
WEB_PORT=8080
